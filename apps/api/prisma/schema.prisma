// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  AICTE_ADMIN
  INSTITUTION_ADMIN
  INSTITUTION_OPERATOR
  STUDENT
  VERIFIER
}

enum EnrolmentStatus {
  ADMITTED
  PENDING_REVIEW
  ACTIVE
  ON_BREAK
  TRANSFERRED_OUT
  WITHDRAWN
  CANCELLED
  COMPLETED
}

enum SeatType {
  REGULAR
  SUPERNUMERARY
  LATERAL_ENTRY
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  fullName     String
  role         UserRole
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  sessions     Session[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([institutionId])
  @@index([role])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Institution {
  id         String      @id @default(uuid())
  aicteCode  String      @unique
  name       String
  state      String
  programmes Programme[]
  users      User[]
  cases      Case[]
  createdAt  DateTime    @default(now())
}

model Programme {
  id             String      @id @default(uuid())
  institutionId  String
  institution    Institution @relation(fields: [institutionId], references: [id])
  name           String
  academicYear   Int
  shift          Int         @default(1)
  approvedIntake Int
  lateralIntake  Int         @default(0)
  enrolments     Enrolment[]

  @@unique([institutionId, name, academicYear, shift])
}

model Student {
  id          String      @id @default(uuid())
  apaarId     String?     @unique
  fullName    String
  dateOfBirth DateTime    @db.Date
  enrolments  Enrolment[]
  createdAt   DateTime    @default(now())
}

model Enrolment {
  id                  String          @id @default(uuid())
  studentId           String
  student             Student         @relation(fields: [studentId], references: [id])
  programmeId         String
  programme           Programme       @relation(fields: [programmeId], references: [id])
  status              EnrolmentStatus
  seatType            SeatType        @default(REGULAR)
  isNri               Boolean         @default(false)
  isOci               Boolean         @default(false)
  isForeignNational   Boolean         @default(false)
  startDate           DateTime        @db.Date
  endDate             DateTime?       @db.Date
  previousEnrolmentId String?         @unique
  previousEnrolment   Enrolment?      @relation("EnrolmentTransfer", fields: [previousEnrolmentId], references: [id])
  nextEnrolment       Enrolment?      @relation("EnrolmentTransfer")
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  cases               Case[]

  @@index([studentId])
  @@index([programmeId, status])
}

enum CaseType {
  OVERLAP
  INTAKE_EXCEEDED
  MISSING_APAAR
  OTHER
}

enum CaseStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  ESCALATED
  REJECTED
}

model Case {
  id              String     @id @default(uuid())
  type            CaseType
  status          CaseStatus @default(OPEN)
  studentId       String?
  enrolmentId     String?
  enrolment       Enrolment? @relation(fields: [enrolmentId], references: [id])
  institutionId   String?
  institution     Institution? @relation(fields: [institutionId], references: [id])
  description     String
  resolutionNotes String?
  resolvedById    String?
  resolvedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status])
  @@index([type])
  @@index([institutionId])
}

